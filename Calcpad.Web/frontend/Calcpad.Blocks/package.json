{
  "name": "@calcpad/blocks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Source-backed visual worksheet UI and contracts for Calcpad",
  "files": [
    "dist"
  ],
  "main": "./dist/calcpad-blocks.js",
  "module": "./dist/calcpad-blocks.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/calcpad-blocks.js"
    }
  },
  "scripts": {
    "build": "vue-tsc --declaration --emitDeclarationOnly --noEmit false --outDir dist/types && vite build",
    "test": "tsx --test tests/core/source-range.test.ts tests/contracts/highlighter-contract.test.ts",
    "typecheck": "vue-tsc --noEmit",
    "dev": "vite --host 127.0.0.1"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "tsx": "^4.23.4",
    "typescript": "^5.9.0",
    "vite": "^8.1.3",
    "vue": "^3.5.39",
    "vue-tsc": "^3.3.13"
  },
  "dependencies": {
    "monaco-editor": "^0.52.2"
  }
}
